# Koppeling met de Apple/iCloud gezinsagenda (alleen lezen). Laat leeg om uit te zetten.
# Maak een app-specifiek wachtwoord aan op https://account.apple.com → Inloggen en beveiliging.
CALDAV_USER=jouw@icloud.com
# Zet waarden met een $ tussen enkele aanhalingstekens, anders knipt compose ze af.
CALDAV_PASSWORD='xxxx-xxxx-xxxx-xxxx'
# Agenda's precies zoals ze in de Agenda-app heten, met standaardbestemming voor afspraken
# zonder tag: 'gezin' of gezinsleden gescheiden door '+'. Tags achter de titel gaan altijd voor.
CALDAV_CALENDARS=Family=gezin,Sepp en Liz=gezin
# Hoe vaak synchroniseren, in minuten
CALDAV_SYNC_MINUTES=10

# Huiswerkhulp: tussenstuk op de host (zie tutor-bridge/README in README.md). Zelfde geheim als in /etc/tutor-bridge.env.
TUTOR_BRIDGE_URL=http://host.docker.internal:3100
TUTOR_SECRET=vul-hier-een-lang-willekeurig-geheim-in

# HTTPS via Caddy (zie README): acme-dns-account, aanmaken met: curl -X POST https://auth.acme-dns.io/register
# Zet bij de DNS: _acme-challenge.planner CNAME <subdomain>.auth.acme-dns.io
ACMEDNS_USERNAME=
ACMEDNS_PASSWORD=
ACMEDNS_SUBDOMAIN=
ACMEDNS_SERVER_URL=https://auth.acme-dns.io
